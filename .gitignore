# ============================================================
# EnObra — monorepo: backend (Django) + frontend (React)
# ============================================================

# ---------- Python / Django ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Variables de entorno y secretos (NUNCA subir)
.env
.env.*
!.env.example
!backend/.env.production.example
*.pem
*.key
secrets.json

# Base de datos locales
*.sqlite3
*.sqlite3-journal
*.db

# Migraciones: se versionan (NO ignorar). Solo se ignoran caches.
# Archivos subidos y estáticos generados
/media/
/staticfiles/
/static_root/
/backend/media/
/backend/staticfiles/
/backend/static_root/

# Tests / cobertura / linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Logs
*.log
/logs/
/backend/logs/

# Django local
local_settings.py

# ---------- Node / React ----------
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.vite/
frontend/coverage/
.next/
.parcel-cache/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
