# Solo desarrollo local. En producción usa una clave propia y DEBUG=false.
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
MEDIA_MAX_UPLOAD_BYTES=10485760
# Opcionales: directorio de imágenes y URL pública del servidor de archivos.
# MEDIA_ROOT=C:/ruta/absoluta/enobra-media
MEDIA_URL=/media/

# BE-09: notificación por correo al recibir una consulta (config/settings.py y
# config/bindings.py ya las leen y registran). Sin INQUIRY_NOTIFY_EMAILS no se envía nada.
INQUIRY_NOTIFY_EMAILS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=5
FRONTEND_BASE_URL=http://localhost:5173
# SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Pruebas aisladas: django.core.mail.backends.locmem.EmailBackend
# La consola imprime el contenido: usar solo datos ficticios en desarrollo.

# --- Despliegue (Render + R2 + Resend); ver docs/despliegue.md --------------------
# Imágenes: local (disco, desarrollo), cloudinary o r2 (producción).
MEDIA_STORAGE_BACKEND=local
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# R2_ACCOUNT_ID=ID_DE_CUENTA
# R2_ACCESS_KEY_ID=ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=SECRET_ACCESS_KEY
# R2_BUCKET=enobra-media
# R2_PUBLIC_BASE_URL=https://media.tudominio.com.gt
# Correo de consultas: email (SMTP/consola) o resend (API HTTPS; Render bloquea el SMTP).
INQUIRY_NOTIFIER=email
# RESEND_API_KEY=
# Supabase transaction pooler (puerto 6543): DATABASE_POOLER_MODE=transaction
# Producción: DJANGO_DEBUG=false exige DJANGO_SECRET_KEY propia de 32+ caracteres.
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=0
