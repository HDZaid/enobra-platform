# Solo desarrollo local. En producción usa una clave propia y DEBUG=false.
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
MEDIA_MAX_UPLOAD_BYTES=10485760
# Opcionales: directorio de imágenes y URL pública del servidor de archivos.
# MEDIA_ROOT=C:/ruta/absoluta/enobra-media
MEDIA_URL=/media/

# BE-09: Henry debe conectar estas variables en config/settings.py y registrar
# InquiryNotifier -> EmailInquiryNotifier en config/bindings.py. No se leen
# automáticamente desde el adaptador. Sin ese registro no se envían correos.
INQUIRY_NOTIFY_EMAILS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=5
FRONTEND_BASE_URL=http://localhost:5173
# SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Pruebas aisladas: django.core.mail.backends.locmem.EmailBackend
# La consola imprime el contenido: usar solo datos ficticios en desarrollo.
