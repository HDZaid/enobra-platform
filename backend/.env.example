# Solo desarrollo local. En producción usa una clave propia y DEBUG=false.
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
MEDIA_MAX_UPLOAD_BYTES=10485760
# Opcionales: directorio de imágenes y URL pública del servidor de archivos.
# MEDIA_ROOT=C:/ruta/absoluta/enobra-media
MEDIA_URL=/media/
