# Copiar los valores necesarios al hosting, sin subir las claves reales a Git.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=false
# Generar una vez y conservar: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
FRONTEND_BASE_URL=https://www.example.com
DATABASE_URL=
# true SOLO si el proxy de confianza sobreescribe X-Forwarded-Proto (p. ej. Render).
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Medios: activar tras conectar el dominio público de imágenes al bucket R2.
R2_ENABLED=false
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Solo hostname, sin https:// ni barra final.
R2_PUBLIC_HOST=
# Correo: configurar por separado; ver issue #18.
