#!/bin/sh
# Require a conventional subject, including explicitly named merge commits.
IFS= read -r subject < "$1" || test -n "$subject" || exit 1
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|merge)(\([[:alnum:]_. /-]+\))?!?: [^[:space:]].*'; then
  printf '%s\n' \
    'ERROR: usa un commit convencional: tipo(alcance): descripción.' \
    'Ejemplos: feat(frontend): agregar filtros; fix(backend): validar correo.' \
    'Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, merge.' \
    'Al sincronizar usa git merge ... -m "merge: sincronizar cambios del equipo".' >&2
  exit 1
fi
