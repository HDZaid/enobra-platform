# El proxy de Vite envía /api al servidor Django en localhost:8000.
VITE_API_BASE_URL=/api/v1

# Ejemplos públicos de noticias: solo si se activan explícitamente en desarrollo.
VITE_NEWS_PREVIEW=false

# Despliegue (Cloudflare Pages): estas variables se leen al COMPILAR y se configuran en
# Settings > Environment variables de la plataforma. No contienen secretos.
# Producción: VITE_API_BASE_URL=https://api.tudominio.com.gt/api/v1  (sin barra final)
# Solo desarrollo: destino del proxy de Vite hacia Django.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
