# El proxy de Vite envía /api al servidor Django en localhost:8000.
VITE_API_BASE_URL=/api/v1

# Cloudflare Pages (producción): https://enobra-api.onrender.com/api/v1
# Guardar allí y reconstruir; Vite incorpora este valor durante el build.

# Ejemplos públicos de noticias: solo si se activan explícitamente en desarrollo.
VITE_NEWS_PREVIEW=false
